# Copy to .env (same folder) and fill in:  cp env.example .env && nano .env
# .env is git-ignored. Never commit the real one.

TZ=Europe/Zurich

# --- SIP / phone ------------------------------------------------------------
# The Pi's Tailscale IPv4 (run: tailscale ip -4). Asterisk binds SIP to this only.
TAILSCALE_IP=100.82.40.78
# Credentials your phone's SIP app registers with. Generate a password with: openssl rand -hex 16
SIP_USERNAME=mobile
SIP_PASSWORD=CHANGE_ME

# --- Voice / models ---------------------------------------------------------
PIPER_VOICE=en_GB-alan-medium
# tiny.en = fastest, base.en = better accuracy (recommended on a Pi 4), small.en = slow on a Pi 4
WHISPER_MODEL=base.en
# qwen2.5:1.5b is a good fit for a Pi 4 with 8 GB; qwen2.5:0.5b if you want faster replies
OLLAMA_MODEL=qwen2.5:1.5b

# --- Security ---------------------------------------------------------------
# Shared secret the trading bot sends to the bridge. Generate: openssl rand -hex 32
# Put the SAME value in the bot's own .env as ESCALATION_TOKEN.
ESCALATION_TOKEN=CHANGE_ME
# The bot Dashboard API's ADMIN_API_TOKEN (from bosskey_trading_bot/.env). Lets the
# bridge halt trading / switch to PAPER when you confirm it on the call.
BOT_ADMIN_TOKEN=CHANGE_ME
BOT_API_URL=http://host.docker.internal:3000

# Minimum minutes between two calls, so a crash loop can't ring you every minute.
CALL_COOLDOWN_MINUTES=15
